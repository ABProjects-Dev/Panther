<!--
    Solid backdrop for the adaptive launcher icon. The foreground layer carries the branded
    artwork and is opaque, so this colour only shows through during launcher parallax; it is
    kept equal to the artwork's own background so no edge is ever visible.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path
        android:fillColor="#010202"
        android:pathData="M0,0h108v108h-108z" />
</vector>
